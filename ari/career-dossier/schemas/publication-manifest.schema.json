{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.johndifini.com/schemas/publication-manifest.schema.json",
  "title": "Private publication manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "claimId", "privateSourceDigest", "publicContentDigest", "approvedAt", "exportedAt", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "claimId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$" },
    "privateSourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "publicContentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["published", "stale"] }
  }
}
