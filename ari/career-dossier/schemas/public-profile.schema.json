{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.johndifini.com/schemas/public-profile.schema.json",
  "title": "Public career profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "headline", "summary", "website", "visibility", "approvedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "headline": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "location": { "type": "string", "minLength": 1, "maxLength": 120 },
    "website": { "type": "string", "format": "uri", "pattern": "^https://" },
    "visibility": { "const": "public" },
    "approvedAt": { "type": "string", "format": "date-time" }
  }
}
