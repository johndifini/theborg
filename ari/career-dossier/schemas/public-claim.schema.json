{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.johndifini.com/schemas/public-claim.schema.json",
  "title": "Public career claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "title", "claim", "status", "asOf", "skills", "evidenceIds", "limitations", "evidenceLevel", "visibility", "approvedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$" },
    "type": { "enum": ["experience", "project", "leadership", "writing", "speaking", "award", "education"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 180 },
    "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "status": { "enum": ["completed", "historical", "in-development", "scheduled"] },
    "asOf": { "type": "string", "format": "date" },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2})?(?:-[0-9]{2})?$" },
        "end": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2})?(?:-[0-9]{2})?$" }, { "type": "null" }] }
      }
    },
    "organizations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "skills": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$" }, "uniqueItems": true },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidenceLevel": { "enum": ["publicly-documented", "resume-sourced", "candidate-confirmed"] },
    "visibility": { "const": "public" },
    "approvedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "evidenceLevel": { "const": "publicly-documented" } }, "required": ["evidenceLevel"] },
      "then": { "properties": { "evidenceIds": { "type": "array", "minItems": 1 } } }
    }
  ]
}
